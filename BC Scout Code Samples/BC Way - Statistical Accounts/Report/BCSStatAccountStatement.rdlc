            </TablixBody>
            <TablixColumnHierarchy>
              <TablixMembers>
                <TablixMember />
                <TablixMember />
                <TablixMember />
                <TablixMember />
                <TablixMember />
              </TablixMembers>
            </TablixColumnHierarchy>
            <TablixRowHierarchy>
              <TablixMembers>
                <!-- Group per Statistical Account: header row, detail row, footer/total row -->
                <TablixMember>
                  <Group Name="StatAccountGroup">
                    <GroupExpressions>
                      <GroupExpression>=Fields!No_StatAcc.Value</GroupExpression>
                    </GroupExpressions>
                  </Group>
                  <SortExpressions>
                    <SortExpression>
                      <Value>=Fields!No_StatAcc.Value</Value>
                    </SortExpression>
                  </SortExpressions>
                  <TablixMembers>
                    <TablixMember>
                      <!-- Group header: account title row -->
                      <KeepWithGroup>After</KeepWithGroup>
                      <KeepTogether>true</KeepTogether>
                    </TablixMember>
                    <TablixMember>
                      <!-- Group header: column headers -->
                      <KeepWithGroup>After</KeepWithGroup>
                      <KeepTogether>true</KeepTogether>
                    </TablixMember>
                    <TablixMember>
                      <!-- Detail rows -->
                      <Group Name="Details" />
                    </TablixMember>
                    <TablixMember>
                      <!-- Group footer: total row -->
                      <KeepWithGroup>Before</KeepWithGroup>
                    </TablixMember>
                  </TablixMembers>
                </TablixMember>
              </TablixMembers>
            </TablixRowHierarchy>
            <DataSetName>DataSet_Result</DataSetName>
            <Top>1.2cm</Top>
            <Left>0cm</Left>
            <Height>2.45cm</Height>
            <Width>17cm</Width>
            <Style>
